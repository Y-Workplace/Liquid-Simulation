export type WaterSystem = {
	Start: (self: WaterSystem) -> (),
	Stop: (self: WaterSystem) -> (),
	Destroy: (self: WaterSystem) -> (),
	RefreshFromAttributes: (self: WaterSystem, rebuildTiles: boolean?) -> (),
	GetHeight: (self: WaterSystem, worldPosition: Vector3, steps: number?) -> number?,
	GetNormal: (self: WaterSystem, worldPosition: Vector3) -> Vector3?,
	GetVelocity: (self: WaterSystem, worldPosition: Vector3) -> Vector3?,
	IsPointInWaterVolume: (self: WaterSystem, worldPosition: Vector3, surfacePadding: number?, bottomPadding: number?) -> boolean,
	CreateRipple: (self: WaterSystem, worldPosition: Vector3, strength: number?, radius: number?) -> (),
	Splash: (self: WaterSystem, worldPosition: Vector3, strength: number?, radius: number?) -> (),
	Footstep: (self: WaterSystem, worldPosition: Vector3, strength: number?, radius: number?) -> (),
	Explosion: (self: WaterSystem, worldPosition: Vector3, strength: number?, radius: number?) -> (),
	ProjectileImpact: (self: WaterSystem, worldPosition: Vector3, strength: number?, radius: number?) -> (),
	MoveSphere: (
		self: WaterSystem,
		oldWorldCenter: Vector3,
		newWorldCenter: Vector3,
		radius: number,
		strengthScale: number?
	) -> (),
}

